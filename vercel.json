{
  "cleanUrls": true,
  "trailingSlash": false,
  "buildCommand": "node scripts/sync-routes.js",
  "outputDirectory": ".",
  "installCommand": "npm install --omit=dev",
  "redirects": [
    { "source": "/index", "destination": "/", "permanent": true },
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/dashboard", "destination": "/", "permanent": true },
    { "source": "/paces-management", "destination": "/pace", "permanent": true },
    { "source": "/spectra-analytics", "destination": "/analytics", "permanent": true },
    { "source": "/daily-schedule", "destination": "/schedule", "permanent": true },
    { "source": "/subject", "destination": "/subjects", "permanent": true },
    { "source": "/exam-routine", "destination": "/exam", "permanent": true },
    { "source": "/monthly-target-setup", "destination": "/daily-actions/monthly-setup", "permanent": true },
    { "source": "/pages/pace", "destination": "/pace", "permanent": true },
    { "source": "/pages/dashboard", "destination": "/", "permanent": true },
    { "source": "/pages/focus", "destination": "/focus", "permanent": true },
    { "source": "/pages/subjects", "destination": "/subjects", "permanent": true },
    { "source": "/pages/schedule", "destination": "/schedule", "permanent": true },
    { "source": "/pages/analytics", "destination": "/analytics", "permanent": true },
    { "source": "/pages/exam", "destination": "/exam", "permanent": true },
    { "source": "/pages/master-config", "destination": "/master-config", "permanent": true },
    { "source": "/pages/outcome", "destination": "/outcome", "permanent": true },
    { "source": "/pages/daily-actions", "destination": "/daily-actions", "permanent": true },
    { "source": "/pages/daily-actions/monthly-setup", "destination": "/daily-actions/monthly-setup", "permanent": true },
    { "source": "/pages/timer", "destination": "/timer", "permanent": true },
    { "source": "/pace/index", "destination": "/pace", "permanent": true },
    { "source": "/focus/index", "destination": "/focus", "permanent": true },
    { "source": "/subjects/index", "destination": "/subjects", "permanent": true },
    { "source": "/schedule/index", "destination": "/schedule", "permanent": true },
    { "source": "/analytics/index", "destination": "/analytics", "permanent": true },
    { "source": "/exam/index", "destination": "/exam", "permanent": true },
    { "source": "/master-config/index", "destination": "/master-config", "permanent": true },
    { "source": "/outcome/index", "destination": "/outcome", "permanent": true },
    { "source": "/daily-actions/index", "destination": "/daily-actions", "permanent": true },
    { "source": "/daily-actions/monthly-setup/index", "destination": "/daily-actions/monthly-setup", "permanent": true },
    { "source": "/timer/index", "destination": "/timer", "permanent": true },
    { "source": "/api/config.js", "destination": "/api/config", "permanent": true },
    { "source": "/api/config.json", "destination": "/api/config", "permanent": true }
  ],
  "rewrites": [
    { "source": "/login", "destination": "/login.html" },
    { "source": "/((?!api/|.*\\..*).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}

