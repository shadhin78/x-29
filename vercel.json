{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/dashboard", "destination": "/", "permanent": true },
    { "source": "/paces-management", "destination": "/pace", "permanent": true },
    { "source": "/spectra-analytics", "destination": "/analytics", "permanent": true },
    { "source": "/daily-schedule", "destination": "/schedule", "permanent": true },
    { "source": "/subject", "destination": "/subjects", "permanent": true },
    { "source": "/exam-routine", "destination": "/exam", "permanent": true },
    { "source": "/monthly-target-setup", "destination": "/daily-actions/monthly-setup", "permanent": true }
  ],
  "rewrites": [
    { "source": "/login", "destination": "/login.html" },
    { "source": "/((?!api/|.*\\..*).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/((?!api/|icons/|css/|.*\\.(js|css|png|jpg|jpeg|gif|svg|ico|webp|woff|woff2|json)).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}

